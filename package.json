{
  "name": "flux-flasher",
  "version": "3.9.9",
  "description": "Flux Flasher (Beta)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "author": "winki",
  "license": "ISC",
  "dependencies": {
    "mime-types": "^3.0.2",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.flux.flasher",
    "productName": "Flux Flasher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "ico/FluxFlasher.ico"
    },
    "extraResources": [
      "Fonts/**/*",
      "logo/**/*",
      "ico/**/*",
      "game/**/*",
      "sound_effect/**/*"
    ],
    "portable": {
      "artifactName": "FluxFlasher_${version}_beta.exe"
    }
  },
  "allowScripts": {
    "@serialport/bindings-cpp@12.0.1": true,
    "electron@28.3.3": true
  }
}
